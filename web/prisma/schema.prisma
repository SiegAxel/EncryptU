generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactTicket {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String
  reason      String
  phone       String
  description String
  createdAt   DateTime @default(now())

  // NUEVO
  status       String @default("open")
  assignedToId Int?
  assignedTo   User?  @relation("UserToTicket", fields: [assignedToId], references: [id])

  messages TicketMessage[]
}

model TicketMessage {
  id       Int           @id @default(autoincrement())
  ticketId Int
  ticket   ContactTicket @relation(fields: [ticketId], references: [id])
  author    String // "user" | "agent"
  name      String?
  email     String?
  body      String
  createdAt DateTime @default(now())
}

enum Role {
  admin
  soporte
  usuario
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role   @default(usuario)
  createdAt    DateTime @default(now())

  // lado opuesto con el MISMO nombre de relación
  ticketsAssigned ContactTicket[] @relation("UserToTicket")
}
